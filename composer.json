{
  "name": "mainmoney/mm-aggr-php-sdk",
  "description": "PHP SDK for the MainMoney aggregator merchant API",
  "type": "library",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_php_sdk",
  "authors": [{ "name": "MainMoney SARL" }],
  "keywords": ["mainmoney", "payments", "merchant", "sdk"],
  "support": {
    "issues": "https://github.com/MainMoney-Inc/mm_aggr_php_sdk/issues",
    "source": "https://github.com/MainMoney-Inc/mm_aggr_php_sdk"
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.75"
  },
  "autoload": {
    "psr-4": {
      "MainMoney\\Aggregator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MainMoney\\Aggregator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true
  }
}
