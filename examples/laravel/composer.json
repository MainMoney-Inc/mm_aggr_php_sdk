{
  "name": "mainmoney/mm-aggr-example-laravel",
  "description": "Laravel mini-shop example for the MainMoney PHP SDK",
  "type": "project",
  "license": "SEE LICENSE IN LICENSE",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.31",
    "mainmoney/mm-aggr-php-sdk": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "serve": "php artisan serve --host=127.0.0.1 --port=8003"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:MainMoney-Inc/mm_aggr_php_sdk.git"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  }
}
